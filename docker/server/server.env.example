# Copy to server.env (compose) or /etc/hangar/server.env (systemd) and fill in.
# Agents on the server sign in with API keys; a subscription login is for your own notebook only.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Author of commits the agents make in their worktrees.
GIT_AUTHOR_NAME=Hangar Server
GIT_AUTHOR_EMAIL=hangar@example.invalid
GIT_COMMITTER_NAME=Hangar Server
GIT_COMMITTER_EMAIL=hangar@example.invalid
