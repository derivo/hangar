{
  "name": "hangar",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "description": "Desktop shell for isolated apps (bays); first bay manages local AI agent sessions.",
  "license": "MIT",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "postinstall": "node scripts/fix-node-pty.mjs",
    "prepare": "lefthook install || true",
    "dev": "pnpm build:deps && pnpm --filter @hangar/desktop dev",
    "build:deps": "pnpm --filter @hangar/cli --filter @hangar/server --filter './bays/**' build",
    "build": "pnpm -r --if-present build",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "pnpm build && pnpm --filter @hangar/desktop test:e2e",
    "package": "pnpm build && pnpm --filter @hangar/desktop package",
    "create:bay": "node scripts/create-bay.mjs",
    "pack:bay": "node scripts/pack-bay.ts",
    "dev:server": "node scripts/dev-server.mjs",
    "test:ssh": "node scripts/dev-server.mjs && vitest run --config docker/dev-server/vitest.config.ts",
    "package:linux-server": "node scripts/linux-server-package.mjs",
    "test:linux-server": "vitest run --config docker/linux-server/vitest.config.ts",
    "test:linux-setup": "vitest run --config docker/linux-machine/vitest.config.ts",
    "image:server": "node scripts/server-image.mjs",
    "image:relay": "node scripts/relay-image.mjs",
    "test:container": "node scripts/server-image.mjs hangar-server:test && node scripts/relay-image.mjs hangar-relay:test && vitest run --config docker/server/vitest.config.ts && vitest run --config docker/relay/vitest.config.ts",
    "docs:api": "typedoc"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "lefthook": "^2.2.2",
    "prettier": "^3.9.10",
    "typedoc": "^0.28.20",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  }
}
